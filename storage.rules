rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null &&
        request.auth.uid == 'CJzmV3mKGTf3TWpwbmOSKJW3cPv1';
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && firestore.exists(/databases/(default)/documents/administradores/$(request.auth.token.email.lower()));
    }
    function isTeam() {
      return isOwner() || isAdmin();
    }
    match /chatEquipe/{uid}/{filename} {
      // Os anexos só podem ser lidos pela equipe autorizada.
      allow read: if isTeam();
      allow create: if isTeam()
        && request.auth.uid == uid
        && filename.matches('[A-Za-z0-9-]+[.](jpg|png|webp|gif|pdf|txt)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/gif',
          'application/pdf', 'text/plain'
        ];
      allow update, delete: if false;
    }
  }
}
