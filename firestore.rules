rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner() {
      return signedIn() && request.auth.uid == 'CJzmV3mKGTf3TWpwbmOSKJW3cPv1';
    }
    function member() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/administradores/$(request.auth.token.email.lower()));
    }
    function editor() {
      return owner() || member();
    }
    match /chatEquipe/{mensagemId} {
      // Só o dono e administradores autorizados podem ler e enviar.
      allow read: if editor();
      allow create: if editor()
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'texto', 'criadoEm', 'anexo'])
        && request.resource.data.keys().hasAll(['uid', 'nome', 'texto', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 2000
        && (request.resource.data.texto.size() > 0 || request.resource.data.keys().hasAny(['anexo']))
        && (
          !request.resource.data.keys().hasAny(['anexo'])
          || (
            request.resource.data.anexo is map
            && request.resource.data.anexo.keys().hasOnly(['id','nome','tipo','tamanho'])
            && request.resource.data.anexo.keys().hasAll(['id','nome','tipo','tamanho'])
            && request.resource.data.anexo.id is string
            && request.resource.data.anexo.id.matches('[A-Za-z0-9]{15,32}')
            && request.resource.data.anexo.nome is string
            && request.resource.data.anexo.nome.size() > 0
            && request.resource.data.anexo.nome.size() <= 100
            && request.resource.data.anexo.tipo in ['image/jpeg','image/png','image/webp','image/gif','application/pdf','text/plain']
            && request.resource.data.anexo.tamanho is int
            && request.resource.data.anexo.tamanho > 0
            && request.resource.data.anexo.tamanho <= 409600
          )
        )
        && request.resource.data.criadoEm == request.time;
      // Mensagens não podem ser alteradas, apagadas ou forjadas por outro usuário.
      allow update, delete: if false;
    }
    match /chatAnexos/{anexoId} {
      // Anexos armazenados dentro da cota gratuita do Firestore.
      allow get: if editor();
      allow list: if false;
      allow create: if editor()
        && request.resource.data.keys().hasOnly(['uid','nome','tipo','tamanho','base64','criadoEm'])
        && request.resource.data.keys().hasAll(['uid','nome','tipo','tamanho','base64','criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 100
        && request.resource.data.tipo in ['image/jpeg','image/png','image/webp','image/gif','application/pdf','text/plain']
        && request.resource.data.tamanho is int
        && request.resource.data.tamanho > 0
        && request.resource.data.tamanho <= 409600
        && request.resource.data.base64 is string
        && request.resource.data.base64.size() > 0
        && request.resource.data.base64.size() <= 550000
        && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }
    match /presenca/{uid} {
      // Cada pessoa logada atualiza apenas seu próprio sinal de atividade.
      // Somente o dono pode ver a lista e contar visitantes.
      allow read: if owner();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','vistoEm'])
        && request.resource.data.keys().hasAll(['uid','vistoEm'])
        && request.resource.data.uid == uid
        && request.resource.data.vistoEm == request.time;
      allow delete: if false;
    }
    match /denuncias/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tituloId','titulo','motivo','uid','criadoEm'])
        && request.resource.data.keys().hasAll(['tituloId','titulo','motivo','uid','criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tituloId is string
        && request.resource.data.tituloId.size() > 0
        && request.resource.data.tituloId.size() <= 128
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 5
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.criadoEm == request.time;
      allow read, update, delete: if owner();
    }
    match /conteudos/{id} {
      allow read: if true;
      allow create, update, delete: if editor();
    }
    match /administradores/{email} {
      // O administrador pode ler apenas o próprio registro; o dono gerencia todos.
      allow get: if owner() || (
        signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && email == request.auth.token.email.lower()
      );
      allow list: if owner();
      allow create, update: if owner()
        && email.matches('[^/ @]+@[^/ @]+[.][^/ @]+')
        && request.resource.data.keys().hasOnly(['nome','email','adicionadoEm','adicionadoPor'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80
        && request.resource.data.email == email
        && request.resource.data.adicionadoPor == 'CJzmV3mKGTf3TWpwbmOSKJW3cPv1';
      allow delete: if owner();
    }
  }
}
